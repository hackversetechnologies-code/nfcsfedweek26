# Supabase (from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (Resend - resend.com). Only server-side, never exposed to browser.
RESEND_API_KEY=
EMAIL_FROM="NFCS Federation Week <noreply@yourdomain.com>"

# Base URL used inside QR codes / email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Simple shared secret used to gate /admin (see middleware.ts).
# Replace with real Supabase Auth for anything beyond a small volunteer team.
ADMIN_ACCESS_CODE=change-me
